# Apply these variables in your process manager; the application does not auto-load this file.
HOST=127.0.0.1
PORT=8787
# Use a persistent directory outside the source tree in production.
INBOUND_DATA_DIR=./runtime
INBOUND_STORAGE_MODE=sqlite
# Set only behind a trusted proxy that strips incoming forwarded headers.
TRUST_PROXY=0
# With TRUST_PROXY=1: your public https origin, accepted for same-site writes
# when the proxy rewrites the Host header. Example: https://your-app.example.host
# PUBLIC_ORIGIN=
# Set a unique strong value through secret management, never commit it.
# POLICY_ADMIN_TOKEN=
# Optional individual paths override INBOUND_DATA_DIR defaults.
# INBOUND_DB_FILE=
# INBOUND_FEEDBACK_FILE=
# INBOUND_HISTORY_FILE=
# INBOUND_AUDIT_FILE=
# LIVE_STATE_FILE=
LIVE_TIMEOUT_MS=8000
